{
  "name": "copilot-proxy-web-fetch",
  "version": "2.1.1",
  "private": true,
  "description": "A GitHub Copilot web_fetch override without target-address filtering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewFuture/copilot-proxy-web-fetch.git"
  },
  "homepage": "https://github.com/NewFuture/copilot-proxy-web-fetch#readme",
  "bugs": {
    "url": "https://github.com/NewFuture/copilot-proxy-web-fetch/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/patch-dependencies.mjs",
    "build": "node scripts/patch-dependencies.mjs && esbuild src/extension.mjs --bundle --platform=node --format=esm --target=node20 --external:@github/copilot-sdk/extension --outfile=extension.mjs --legal-comments=eof",
    "test": "node --test test/web-fetch.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "node-html-markdown": "2.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
